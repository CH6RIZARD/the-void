# The Void proxy — environment config. Copy to `.env` and fill in as needed.
# Every value is optional; with none set, the keyless Reddit provider runs alone.

# Port the server listens on (default 8787).
PORT=8787

# Twitter/X API v2 bearer token. If set, the XProvider activates and queries the
# recent-search endpoint. If empty/unset, XProvider is inert (returns []).
# Never commit a real token — keep it in .env (which is gitignored), not here.
X_BEARER=

# --- X spend caps (see README "X spend caps") -------------------------------
# X bills per post read ($0.005 each), so XProvider is the only provider that
# costs money. These bound it. Defaults shown; all optional.
# Posts read per UTC day. 1000 = a $5/day ceiling. 0 turns X off entirely.
X_DAILY_POSTS=1000
# Posts per API call (10 is the API's own minimum).
X_MAX_RESULTS=10
# How long one query's result is reused before paying for it again (ms).
X_CACHE_MS=900000
# Share of any returned page that may be X items.
X_MAX_SHARE=0.15

# --- Reddit auth (see README "Reddit auth") ---------------------------------
# From a *script* app at https://www.reddit.com/prefs/apps. Without these the
# provider uses the keyless host, which answers 403 from most servers.
REDDIT_CLIENT_ID=
REDDIT_SECRET=
# Your Reddit handle — only used to build the User-Agent Reddit's rules require.
REDDIT_USERNAME=

# --- Translation ------------------------------------------------------------
# DeepL API key (https://www.deepl.com/pro-api -> "Sign up for free").
# Free keys end in ":fx" and hard-stop at 500k chars/month rather than billing.
# Unset: POST /translate answers 503 and the app falls back to Google's free
# endpoint, which blocks by IP without warning.
DEEPL_KEY=
