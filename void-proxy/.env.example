# The Void proxy — environment config. Copy to `.env` and fill in as needed.
# Every value is optional; with none set, the keyless Reddit provider runs alone.

# Port the server listens on (default 8787).
PORT=8787

# Twitter/X API v2 bearer token. If set, the XProvider activates and queries the
# recent-search endpoint. If empty/unset, XProvider is inert (returns []).
# Never commit a real token — keep it in .env (which is gitignored), not here.
X_BEARER=
