{
  "name": "the-void-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/core/__tests__/golden.test.ts src/core/__tests__/more.test.ts src/features/live/__tests__/hlsVariant.test.ts",
    "build:android": "eas build -p android --profile production",
    "build:android:preview": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile production",
    "submit:ios": "eas submit -p ios --latest",
    "submit:android": "eas submit -p android --latest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.18",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-observe": "~57.0.23",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
