<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tier 4: rear-camera + torch contact PPG. Opt-in only; frames never leave the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Tier 0: IMU is sensor-free of permission, but body-sensors covers some HR sensors. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Tier 1: Health Connect HR / HRV read (paired wearable). -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />

</manifest>
