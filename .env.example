# Copy to .env and fill from Railway / your API host.
# NEVER commit .env.

# Railway Postgres public TCP URL (psql / migrations / seeds)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# Railway CLI — required for non-interactive deploy (agents cannot railway login).
# Either name works; do not commit real values.
# RAILWAY_TOKEN=
# RAILWAY_API_TOKEN=

# After deploy, optional override for health checks:
# VOID_PROXY_URL=https://your-service.up.railway.app

# Client-facing API (Expo app.config.js extra). Use anon/public only.
# If you still front the DB with Supabase Auth/PostgREST, set these.
# If you use a custom Railway API, set that URL instead and adapt void-app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER put service_role or DATABASE_URL in the Expo client.
